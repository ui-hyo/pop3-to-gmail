[Unit]
Description=Watch for stalled mail sync

[Service]
Type=oneshot
WorkingDirectory=%h/email2gmail
ExecStart=/usr/bin/env python3 -m email2gmail.cli watchdog
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
RuntimeDirectory=email2gmail-watchdog
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%t/email2gmail-watchdog
